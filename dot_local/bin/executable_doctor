#!/bin/bash
# doctor — is my system whole?
ok(){ printf '\e[32m✓\e[0m %s\n' "$1"; }; bad(){ printf '\e[31m✗\e[0m %s\n' "$1"; fail=1; }
src=$(chezmoi source-path)

command -v paru >/dev/null && ok paru || bad paru
chezmoi verify &>/dev/null && ok chezmoi || bad "chezmoi drift (chezmoi diff)"
[[ $(getent passwd "$USER" | cut -d: -f7) == */zsh ]] && ok "login shell" || bad "login shell not zsh"

# every package any use case declared — apply never reinstalls one you removed by hand
missing=$(sed -n 's/^  \([a-z0-9][a-z0-9._+-]*\) *\\\?$/\1/p' \
  "$src"/.chezmoiscripts/*/run_onchange_before_packages.sh | sort -u | xargs -r pacman -T 2>/dev/null)
[[ -z $missing ]] && ok packages || bad "missing: ${missing//$'\n'/ }"

ssh-add -l &>/dev/null; (( $? != 2 )) && ok ssh-agent || bad "ssh-agent not answering"
[[ -e /etc/pacman.d/hooks/paccache.hook && -e /etc/pacman.d/hooks/pkglist.hook ]] &&
  ok "pacman hooks" || bad "pacman hooks missing"
zsh -n "$HOME"/.config/zsh/*.zsh 2>/dev/null && ok "zsh config parses" || bad "zsh config syntax"

[[ -s ~/.cache/ls-colors && -S ${XDG_RUNTIME_DIR}/atuin.sock ]] && ok shell || bad "shell (vivid cache / atuin daemon)"

_w=$(grep -c '^\[\[plugin.deps\]\]' ~/.config/yazi/package.toml 2>/dev/null)
_h=$(ls -1d ~/.config/yazi/plugins/*.yazi 2>/dev/null | wc -l)
(( _w == _h )) && ok "yazi plugins ($_h)" || bad "yazi plugins: $_h of $_w installed"

# desktop — the things `chezmoi apply` cannot put back, and the things that fail SILENTLY
_d=
for _u in waybar swaync hypridle hyprsunset cliphist hyprpolkitagent awww-daemon \
          cliphist-image monitor-watch power-profile-watch bt-audio-switch; do
  systemctl --user is-enabled -q "$_u.service" 2>/dev/null || _d="$_d $_u"
done
systemctl --user is-enabled -q battery-notify.timer 2>/dev/null || _d="$_d battery-notify.timer"
[[ -z $_d ]] && ok "session units" || bad "session units disabled:$_d"

_s=$(hyprshade ls 2>/dev/null | wc -l)                       # 2 shipped + our 6
(( _s == 8 )) && ok "screen shaders" || bad "screen shaders: $_s of 8"
luac -p ~/.config/hypr/hyprland.lua 2>/dev/null && ok "hyprland.lua parses" || bad "hyprland.lua syntax"

# ⚠ the compositor's PATH, not the shell's. Binds exec through /bin/sh, which never sources
# zshenv — when ~/.local/bin was missing here, all 57 binds registered, configerrors was empty,
# and EVERY script bind silently ran a command that did not exist.
if pgrep -x Hyprland >/dev/null; then
  tr '\0' '\n' < /proc/"$(pgrep -x Hyprland | head -1)"/environ | grep -q "^PATH=.*$HOME/\.local/bin" \
    && ok "compositor PATH" || bad "~/.local/bin missing from the compositor PATH — script binds are dead"
fi

# ⚠ by D-BUS OWNER, not by is-active: tlp-pd and power-profiles-daemon both claim this name,
# the loser dies quietly, and the winner answers normall
_o=$(busctl --system list 2>/dev/null | awk '/^net\.hadess\.PowerProfiles/{print $6}')
[[ $_o == tlp-pd.service ]] && ok "power profiles (tlp-pd)" || bad "PowerProfiles owned by ${_o:-nobody}, want tlp-pd.service"

# ⚠ enabled is NOT running, and for a TIMER the gap can last until the next reboot
_d=
for _t in battery-notify.timer sun.timer; do
  systemctl --user is-enabled -q "$_t" 2>/dev/null || continue
  systemctl --user is-active  -q "$_t" 2>/dev/null || _d="$_d $_t"
done
[[ -z $_d ]] && ok "timers running" || bad "enabled but never started:$_d — systemctl --user enable --now$_d"

# theming — a fragment nothing imports is a file, not a theme
_t=$(cat ~/.config/themes/.current 2>/dev/null || echo none)
[[ $_t != none ]] && ok "theme ($_t)" || bad "no theme applied — run: theme set catppuccin-dark"

# every seam actually points at the fragment the CLI writes
_s=0
grep -q '@import "colors.css"' ~/.config/waybar/style.css 2>/dev/null || _s=$((_s+1))
grep -q '@import "colors.css"' ~/.config/swaync/style.css 2>/dev/null || _s=$((_s+1))
grep -q '@theme' ~/.config/rofi/config.rasi 2>/dev/null || _s=$((_s+1))
grep -qE '^\s*theme "theme"' ~/.config/zellij/config.kdl 2>/dev/null || _s=$((_s+1))
grep -qE '^\s*color_theme\s*=\s*"?theme' ~/.config/btop/btop.conf 2>/dev/null || _s=$((_s+1))
(( _s == 0 )) && ok "theme seams" || bad "$_s theme fragment(s) written but never imported"

# the cursor NAME, not just its size — Bibata was installed and selected nowhere for weeks
[[ $(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null) == *Bibata* ]] \
  && ok "cursor theme" || bad "cursor-theme is not Bibata (gsettings)"

# the one BEHAVIOUR seam — a security seam, so it is checked; the other two are recorded choices
grep -qE '^\s*lock_cmd.*\block$' ~/.config/hypr/hypridle.conf 2>/dev/null \
  && ok "idle-lock resets layout" || bad "hypridle calls hyprlock directly — a non-US layout locks you out"

# GTK3's dark switch — unreachable from gsettings, so nothing else would catch it
grep -qx 'gtk-application-prefer-dark-theme=1' ~/.config/gtk-3.0/settings.ini 2>/dev/null \
  && ok "GTK3 dark" || bad "GTK3 apps render light — see theming.md § GTK/Qt/cursor 1b"

# hybrid: the dGPU must be ASLEEP when nothing asked for it. nvidia-smi showing a low-watt P8
# is NOT this — P8 is an awake idle state, D3cold is off. Reading sysfs does not wake it.
_g=$(ls -d /sys/bus/pci/drivers/nvidia/0000:* 2>/dev/null | head -1)
if [[ $_g && -r $_g/power/runtime_status ]]; then
  _st=$(cat "$_g/power/runtime_status")
  [[ $_st == suspended ]] && ok "dGPU asleep" \
    || bad "dGPU is '$_st', want suspended — expected right after CUDA or a prime-run app, otherwise something holds it awake (desktop.md § env.tmpl)"
fi

# `set which-key easymotion` in ~/.ideavimrc is a SILENT no-op without the plugins, and
# JetBrains ships no CLI installer, so nothing in chezmoi can put them there.
_r=$(ls -d ~/.local/share/JetBrains/Rider* 2>/dev/null | head -1)
if [[ $_r ]]; then
  _m=
  for _p in ideavim which-key easymotion acejump; do
    ls "$_r" 2>/dev/null | grep -qi -- "$_p" || _m="$_m $_p"
  done
  [[ -z $_m ]] && ok "Rider vim plugins" || bad "Rider plugins missing:$_m — Settings → Plugins"
fi

# signing: the key file must exist AND this machine's pubkey must be in allowed_signers.
# Signing and verifying fail separately — a commit signs fine while `git log --show-signature`
# says "No signature" forever, because the verify side never saw the key.
_sk=$(git config --global user.signingkey 2>/dev/null)
_sk=${_sk/#\~/$HOME}
[[ -r $_sk ]] && ok "signing key" || bad "signingkey unreadable: ${_sk:-unset}"
_as=$(git config --global gpg.ssh.allowedSignersFile 2>/dev/null); _as=${_as/#\~/$HOME}
if [[ -r $_as && -r $_sk ]]; then
  grep -qF "$(awk '{print $2}' "$_sk")" "$_as" \
    && ok "allowed_signers" || bad "this machine's pubkey is not in $_as — signatures will never verify"
else
  bad "allowed_signers unreadable: ${_as:-unset}"
fi

grep -q '^background_opacity' ~/.config/kitty/theme.conf 2>/dev/null \
  && ok "kitty opacity" || bad "kitty fragment has no background_opacity — matugen template drift?"

exit ${fail:-0}

