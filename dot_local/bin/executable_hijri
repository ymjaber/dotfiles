#!/bin/bash
# hijri [--set N] — adjusted Hijri date in Arabic; N = day offset for local moon sighting
O=~/.config/prayer/hijri-offset; [[ $1 == --set ]] && { mkdir -p "${O%/*}"; echo "${2:-0}" > "$O"; exit; }
python3 - "$(cat "$O" 2>/dev/null || echo 0)" <<'PY'
import sys, datetime
from hijridate import Gregorian
d = datetime.date.today() + datetime.timedelta(days=int(sys.argv[1]))
h = Gregorian.fromdate(d).to_hijri()
print(f"{h.day} {h.month_name('ar')} {h.year}")
PY
