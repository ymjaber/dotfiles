#!/bin/bash
# bt-audio-switch ← dot_local/bin/executable_bt-audio-switch
route() { local sink; for _ in $(seq 6); do
    sink=$(pactl list short sinks | awk '/bluez/{print $2; exit}'); [[ $sink ]] && break; sleep 1; done
  [[ $sink ]] || return; pactl set-default-sink "$sink"
  pactl list short sink-inputs | while read -r id _; do pactl move-sink-input "$id" "$sink"; done; }
dbus-monitor --system "type='signal',path_namespace='/org/bluez',member='PropertiesChanged'" 2>/dev/null \
  | while read -r l; do [[ $l == *'"Connected"'* ]] && { read -r v; [[ $v == *'boolean true'* ]] && route; }; done
