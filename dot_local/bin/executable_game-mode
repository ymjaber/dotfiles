#!/bin/bash
# game-mode ← dot_local/bin/executable_game-mode   (game-mode on|off|toggle|reapply)
flag=~/.cache/game-mode
on(){ hyprctl eval 'hl.config({
    animations = { enabled = false },
    decoration = { blur = { enabled = false }, shadow = { enabled = false }, rounding = 0,
                   active_opacity = 1.0, inactive_opacity = 1.0, fullscreen_opacity = 1.0 },
    general    = { gaps_in = 0, gaps_out = 0, border_size = 1, allow_tearing = true },
  })' >/dev/null
  local rc=0 had=0
  systemctl --user is-active --quiet hypridle.service && had=1
  printf '%s\n' "$had" > "$flag"
  systemctl --user stop hypridle.service || rc=1
  tlpctl set performance 2>/dev/null || rc=1
  (( rc )) && notify-send -u critical -a game-mode "game mode ON (partial — check journalctl)" \
           || notify-send -a game-mode "game mode ON"; }
off(){ local had; had=$(cat "$flag" 2>/dev/null || echo 1); rm -f "$flag"
  hyprctl reload
  [[ $had == 1 ]] && systemctl --user start hypridle.service
  tlpctl set balanced 2>/dev/null
  notify-send -a game-mode "game mode OFF"; }
# ⚠ NOT `[[ -e $flag ]] && off || on`: off()'s last command is notify-send, which exits 1 when
# it cannot reach a notification daemon — the || arm would then ALSO run on(), turning game
# mode back on immediately after turning it off. And a `*)` arm matters because this script is
# reachable two ways (SUPER+SHIFT+G, by hand); without it a typo silently returns 0.
case "${1:-toggle}" in
  on)      on ;;
  off)     off ;;
  toggle)  if [[ -e $flag ]]; then off; else on; fi ;;
  reapply) [[ -e $flag ]] && on ;;
  *)       echo "usage: game-mode on|off|toggle|reapply" >&2; exit 2 ;;
esac
exit 0
