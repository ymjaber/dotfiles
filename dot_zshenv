# Fallback for machines that don't export these
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export ZDOTDIR="$HOME/.config/zsh"          # zsh reads its config from here, not ~
typeset -U path; path=(~/.local/bin $path)  # user bins (doctor, later theme/menu-*); -U dedupes
export EDITOR=nvim VISUAL=nvim

# fallback only: an inbound ssh session already has a FORWARDED agent socket
[[ -n $SSH_AUTH_SOCK ]] || export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

export MANPAGER="bat -plman" # man pages rendered by bat
export MANROFFOPT="-c"
