# order matters: options first, plugins wrap the line, hooks init tools last
for f in options plugins keybinds aliases functions hooks; do
  source "$ZDOTDIR/$f.zsh"
done

# use-case modules plug in here; (N) = no error while the dir is empty or missing
for m in "$ZDOTDIR"/modules/*.zsh(N); do source "$m"; done

# re-apply the live terminal palette if the theme engine has written one
[[ -r ~/.cache/theme-sequences ]] && cat ~/.cache/theme-sequences

# syntax-highlighting wraps every ZLE widget, so it loads dead last
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
