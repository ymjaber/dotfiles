{
  // height must be >= the modules' computed minimum (33 for this stylesheet: font-size 13
  // + the 0 10px paddings + tray icon metrics). 30 warned and was silently forced to 33;
  // omitting the key is worse — Waybar falls back to 20. Logical pixels, so scale-independent.
  "layer": "top", "height": 30, "spacing": 6,

  // overlays append their module file here, e.g. "~/.config/waybar/modules/prayer.jsonc"
  // ⚠ comment stays OUTSIDE the brackets: jsoncpp reads a comment inside an array as
  // preceding a value, so [ /* c */ ] promises a value and then delivers ]
  "include": [],

  "modules-left":   ["hyprland/workspaces", "hyprland/submap", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right":  ["tray", "idle_inhibitor", "hyprland/language", "wireplumber", "network", "bluetooth", "battery"],

  "hyprland/workspaces": { "format": "{id}", "on-click": "activate" },
  "hyprland/submap": { "format": " {}", "tooltip": false },   // never get stuck in a submap silently
  // A5: SUPER+Space flips us↔ara. Without this the flip is invisible — you find out by typing.
  "hyprland/language": {
    "format": "{short}",
    "keyboard-name": "at-translated-set-2-keyboard"
  },
  "idle_inhibitor": { "format": "{icon}", "format-icons": { "activated": "", "deactivated": "" },
    "tooltip-format-activated": "caffeine on (idle inhibited)", "tooltip-format-deactivated": "caffeine off" },
  "hyprland/window": { "max-length": 60, "separate-outputs": true },
  "clock": {
    "format": "{:%a %d · %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "on-click": "mode"                    // cycle month/year in the tooltip
  },
  "wireplumber": {
    "format": "{icon} {volume}%", "format-muted": "muted",
    "format-icons": ["", "", ""],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "uwsm app -- pwvucontrol"
  },
  "network": {
    "format-wifi": "  {signalStrength}%", "format-ethernet": "󰈀",
    "format-disconnected": "󰤭", "tooltip-format": "{essid} · {ipaddr}",
    // PASS 1 value — pass 2 swaps this to "menu-wifi" once the script exists
    "on-click": "uwsm app -- nm-connection-editor"
  },
  "bluetooth": {
    "format": "", "format-off": "", "format-connected": " {num_connections}",
    "on-click": "uwsm app -- blueman-manager"
  },
  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%", "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },
  "tray": { "spacing": 8 }
}
