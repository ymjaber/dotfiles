/* dot_config/rofi/theme.rasi — layout only; colours come from colors.rasi, written by `theme` */
@import "colors.rasi"
* { background-color: transparent; text-color: @fg;
    font: "JetBrainsMono Nerd Font 11"; }
window   { width: 40%; background-color: @bg; border: 2px; border-color: @accent;
           border-radius: 12px; padding: 8px; }
mainbox  { children: [ inputbar, listview, mode-switcher ]; spacing: 8px; }
inputbar { children: [ prompt, entry ]; background-color: @bg-alt;
           border-radius: 8px; padding: 10px 12px; spacing: 8px; }
prompt   { text-color: @accent; }
entry    { placeholder: "search…"; placeholder-color: @muted; }
listview { lines: 10; scrollbar: false; fixed-height: false; spacing: 2px; }
element  { padding: 8px 12px; border-radius: 8px; spacing: 10px; }
element normal normal   { text-color: @fg; }
element normal urgent   { text-color: @urgent; }
element selected normal { background-color: @accent; text-color: @bg; }
element-icon { size: 1.2em; vertical-align: 0.5; }
element-text { vertical-align: 0.5; }

mode-switcher { spacing: 4px; }
button          { padding: 6px; border-radius: 8px;
                  background-color: @bg-alt; text-color: @muted; }
button selected { background-color: @accent;  text-color: @bg; }
