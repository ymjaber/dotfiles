# ⚠⚠ PATH — the single most load-bearing line here. ~/.local/bin is added by dot_zshenv, which
# is ZSH-ONLY. Hyprland execs every bind through /bin/sh -c, which never sources it, so the
# compositor's PATH lacked ~/.local/bin and EVERY script bind silently resolved to nothing.
# uwsm sources this before the compositor AND imports it into the systemd user manager.
export PATH="$HOME/.local/bin:$PATH"
export QT_QPA_PLATFORM="wayland;xcb"        # wayland, X11 only as fallback
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GDK_BACKEND="wayland,x11"
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
{{ if eq .gpu "nvidia" }}
export LIBVA_DRIVER_NAME=nvidia
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export NVD_BACKEND=direct
{{ end }}
