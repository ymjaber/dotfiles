export XCURSOR_SIZE=24
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME=Bibata-Modern-Classic
export HYPRCURSOR_THEME=Bibata-Modern-Classic

# AQ_DRM_DEVICES — pin the compositor to the display GPU so it never opens the dGPU's render
# node. Aquamarine otherwise enumerates every DRM device and holds renderD129 for the life of
# the session, keeping an offload-only dGPU at D0 (~4.5 W) whatever the driver's runtime-PM
# setting says. Computed, not named: no driver, no PCI path, no card number to edit per machine.
# Fails safe — find nothing and the variable stays unset, which is what boots today.
for _c in /sys/class/drm/card[0-9]*; do
  [ -e "$_c/device/driver" ] || continue
  case "$(basename "$(readlink -f "$_c/device/driver")")" in nvidia) continue ;; esac
  ls -d "$_c"-* >/dev/null 2>&1 || continue
  AQ_DRM_DEVICES="/dev/dri/${_c##*/}"; export AQ_DRM_DEVICES; break
done
